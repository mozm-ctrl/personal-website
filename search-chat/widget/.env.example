# 复制为 .env 后填写。.env 里有 Key，不要提交、不要发给别人。

# ===== 模型（OpenAI 兼容接口，必填）=====
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT=120s
# LLM_REASONING_EFFORT=none

# ===== 搜索 =====
SEARCH_ENGINE=auto
TAVILY_API_KEY=
BOCHA_API_KEY=
# SEARCH_RESULTS=5
# SEARCH_CACHE_TTL=5m

# ===== 服务与安全 =====
PORT=8080
ALLOWED_ORIGINS=https://www.example.com
ACCESS_TOKEN=
RATE_LIMIT_PER_MIN=10
# TRUST_PROXY=1
# MAX_CONCURRENT=4
